{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nerd.local/schemas/ipc.schema.json",
  "title": "Nerd IPC Protocol 1",
  "oneOf": [
    { "$ref": "#/$defs/requestEnvelope" },
    { "$ref": "#/$defs/responseEnvelope" },
    { "$ref": "#/$defs/eventEnvelope" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "protocolVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "applicationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000]+$"
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "request"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "request": { "$ref": "#/$defs/request" }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "handshake" },
            "payload": { "$ref": "#/$defs/handshakeRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "status" },
            "payload": { "$ref": "#/$defs/statusRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_setup" },
            "payload": { "$ref": "#/$defs/networkSetupRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_uninstall" },
            "payload": { "$ref": "#/$defs/networkUninstallRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_repair" },
            "payload": { "$ref": "#/$defs/networkRepairRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_status" },
            "payload": { "$ref": "#/$defs/networkStatusRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_install" },
            "payload": { "$ref": "#/$defs/runtimeInstallRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_list" },
            "payload": { "$ref": "#/$defs/runtimeListRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_remove" },
            "payload": { "$ref": "#/$defs/runtimeRemoveRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_set_default" },
            "payload": { "$ref": "#/$defs/runtimeSetDefaultRequest" }
          }
        }
      ]
    },
    "handshakeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientKind",
        "clientVersion",
        "minimumProtocolVersion",
        "maximumProtocolVersion"
      ],
      "properties": {
        "clientKind": { "enum": ["cli", "desktop"] },
        "clientVersion": { "$ref": "#/$defs/applicationVersion" },
        "minimumProtocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "maximumProtocolVersion": { "$ref": "#/$defs/protocolVersion" }
      }
    },
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "networkSetupRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "networkUninstallRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "networkRepairRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "networkStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "runtimeInstallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeListRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "runtimeRemoveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeId"],
      "properties": {
        "runtimeId": { "$ref": "#/$defs/uuid" }
      }
    },
    "runtimeSetDefaultRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "response"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "response": { "$ref": "#/$defs/response" }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "handshake" },
            "payload": { "$ref": "#/$defs/handshakeResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "status" },
            "payload": { "$ref": "#/$defs/statusResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_setup" },
            "payload": { "$ref": "#/$defs/networkSetupResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_uninstall" },
            "payload": { "$ref": "#/$defs/networkUninstallResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_repair" },
            "payload": { "$ref": "#/$defs/networkRepairResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "network_status" },
            "payload": { "$ref": "#/$defs/networkStatusResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_install" },
            "payload": { "$ref": "#/$defs/runtimeInstallResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_list" },
            "payload": { "$ref": "#/$defs/runtimeListResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_remove" },
            "payload": { "$ref": "#/$defs/runtimeRemoveResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "runtime_set_default" },
            "payload": { "$ref": "#/$defs/runtimeSetDefaultResponse" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "error" },
            "payload": { "$ref": "#/$defs/errorResponse" }
          }
        }
      ]
    },
    "handshakeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daemonInstanceId", "applicationVersion", "selectedProtocolVersion"],
      "properties": {
        "daemonInstanceId": { "$ref": "#/$defs/uuid" },
        "applicationVersion": { "$ref": "#/$defs/applicationVersion" },
        "selectedProtocolVersion": { "$ref": "#/$defs/protocolVersion" }
      }
    },
    "statusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daemon", "health", "paths"],
      "properties": {
        "daemon": { "$ref": "#/$defs/daemonIdentity" },
        "health": { "$ref": "#/$defs/daemonHealth" },
        "paths": { "$ref": "#/$defs/dataPaths" },
        "resources": { "$ref": "#/$defs/processResources" }
      }
    },
    "daemonIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "processId",
        "applicationVersion",
        "protocolVersion",
        "uptimeMs"
      ],
      "properties": {
        "instanceId": { "$ref": "#/$defs/uuid" },
        "processId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "applicationVersion": { "$ref": "#/$defs/applicationVersion" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "uptimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "daemonHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "components"],
      "properties": {
        "status": { "$ref": "#/$defs/healthStatus" },
        "components": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/healthComponent" }
        }
      }
    },
    "healthStatus": {
      "enum": ["healthy", "degraded", "unhealthy"]
    },
    "healthComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "status"],
      "properties": {
        "component": { "enum": ["state", "logging", "ipc", "resources"] },
        "status": { "$ref": "#/$defs/healthStatus" },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "dataPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataDirectory", "databasePath", "logDirectory"],
      "properties": {
        "dataDirectory": { "type": "string", "minLength": 1 },
        "databasePath": { "type": "string", "minLength": 1 },
        "logDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "processResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingSetBytes", "peakWorkingSetBytes", "privateUsageBytes"],
      "properties": {
        "workingSetBytes": { "type": "integer", "minimum": 0 },
        "peakWorkingSetBytes": { "type": "integer", "minimum": 0 },
        "privateUsageBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "networkSetupResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "rolledBack"],
      "properties": {
        "success": { "type": "boolean" },
        "rolledBack": { "type": "boolean" },
        "nrptRuleName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "networkUninstallResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "removedNrptRule", "removedCa", "preservedUnrelatedRules"],
      "properties": {
        "success": { "type": "boolean" },
        "removedNrptRule": { "type": "boolean" },
        "removedCa": { "type": "boolean" },
        "preservedUnrelatedRules": { "type": "integer", "minimum": 0 }
      }
    },
    "networkRepairResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "action"],
      "properties": {
        "success": { "type": "boolean" },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "networkStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dnsListenerActive", "nrptRulePresent", "caPresent"],
      "properties": {
        "dnsListenerActive": { "type": "boolean" },
        "nrptRulePresent": { "type": "boolean" },
        "caPresent": { "type": "boolean" },
        "port53Conflict": { "$ref": "#/$defs/portConflict" },
        "port80Conflict": { "$ref": "#/$defs/portConflict" },
        "port443Conflict": { "$ref": "#/$defs/portConflict" }
      }
    },
    "portConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "protocol", "owningProcessId"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "minLength": 1 },
        "owningProcessId": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "runtimeInstallResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installed", "version"],
      "properties": {
        "installed": { "type": "boolean" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimes"],
      "properties": {
        "runtimes": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeInfo" }
        }
      }
    },
    "runtimeRemoveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removed", "wasManaged"],
      "properties": {
        "removed": { "type": "boolean" },
        "wasManaged": { "type": "boolean" }
      }
    },
    "runtimeSetDefaultResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "kind",
        "tool",
        "version",
        "executablePath",
        "architecture",
        "status"
      ],
      "properties": {
        "runtimeId": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["managed", "external"] },
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executablePath": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ready", "degraded"] }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "allOf": [
        {
          "if": {
            "properties": { "code": { "const": "protocol_mismatch" } },
            "required": ["code"]
          },
          "then": {
            "required": ["minimumProtocolVersion", "maximumProtocolVersion"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["minimumProtocolVersion"] },
                { "required": ["maximumProtocolVersion"] }
              ]
            }
          }
        }
      ],
      "properties": {
        "code": {
          "enum": [
            "protocol_mismatch",
            "handshake_required",
            "invalid_request",
            "daemon_unhealthy",
            "shutting_down",
            "internal"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "retryable": { "type": "boolean" },
        "minimumProtocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "maximumProtocolVersion": { "$ref": "#/$defs/protocolVersion" }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "operationId", "sequence", "event"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event": { "$ref": "#/$defs/event" }
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "progress" },
            "payload": { "$ref": "#/$defs/progressEvent" }
          }
        }
      ]
    },
    "progressEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message", "cancellable"],
      "properties": {
        "stage": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cancellable": { "type": "boolean" },
        "completedUnits": { "type": "integer", "minimum": 0 },
        "totalUnits": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
